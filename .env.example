POSTGRES_DB=mtg
POSTGRES_USER=mtg
POSTGRES_PASSWORD=troque_esta_senha

# default_cards = uma impressão representativa/preferencial por objeto do bulk.
# all_cards = todas as impressões/idiomas disponíveis no bulk (bem maior).
SCRYFALL_BULK_TYPE=default_cards

# Use um identificador próprio e, se desejar, inclua um contato.
SCRYFALL_USER_AGENT=BernardoMTGLocal/1.0

# Administrador criado na primeira vez que o app sobe (banco sem usuários).
# Sem ADMIN_PASSWORD, uma senha aleatória é gerada e gravada em storage/admin-inicial.txt
# e no log (docker compose logs app). Troque-a em /account.php depois de entrar.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@deckarium.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Rotina automática (cron dentro do container): verifica o Scryfall nos horários
# abaixo e, só quando há publicação nova, importa o catálogo e baixa as imagens.
# O histórico de cada execução aparece em Status.
AUTO_UPDATE_ENABLED=1
AUTO_UPDATE_TIMES=06:10,18:10
# all = todas as impressões | unique = uma imagem por carta lógica
AUTO_UPDATE_IMAGE_MODE=all
AUTO_UPDATE_IMAGE_CONCURRENCY=4
TZ=America/Sao_Paulo
