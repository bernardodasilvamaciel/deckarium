# Imagem de produção: o código vai dentro da imagem (sem bind mount de ./app).
# Build a partir da raiz do repositório: docker compose -f docker-compose.prod.yml build
FROM php:8.3-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev ca-certificates curl cron tzdata \
    && docker-php-ext-install pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

# remoteip: usa o IP real do visitante enviado pelo Cloudflare (CF-Connecting-IP)
RUN a2enmod headers remoteip rewrite

COPY docker/php/php.ini /usr/local/etc/php/conf.d/mtg.ini
COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/zz-prod.ini
COPY docker/php/remoteip.conf /etc/apache2/conf-enabled/remoteip.conf
COPY docker/php/sitemap.conf /etc/apache2/conf-enabled/sitemap.conf

# Apache escuta no endereço de APACHE_LISTEN (rede do host; padrão 127.0.0.1:8000).
ENV APACHE_LISTEN=127.0.0.1:8000
RUN sed -ri 's/^Listen 80$/Listen ${APACHE_LISTEN}/' /etc/apache2/ports.conf \
    && sed -ri 's/<VirtualHost \*:80>/<VirtualHost *>/' /etc/apache2/sites-available/000-default.conf \
    && grep -q 'Listen ${APACHE_LISTEN}' /etc/apache2/ports.conf

# Rotina automática do acervo: o entrypoint monta o cron a partir de AUTO_UPDATE_* e TZ.
ENV TZ=America/Sao_Paulo
COPY docker/php/entrypoint.sh /usr/local/bin/deckarium-entrypoint
RUN chmod +x /usr/local/bin/deckarium-entrypoint

COPY app/ /var/www/html/

RUN mkdir -p /var/www/storage/bulk /var/www/storage/images \
    && chown -R www-data:www-data /var/www/storage

WORKDIR /var/www/html
ENTRYPOINT ["deckarium-entrypoint"]
CMD ["apache2-foreground"]
